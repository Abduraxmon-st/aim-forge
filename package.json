{
  "name": "aimforge",
  "version": "1.0.0",
  "description": "Local-first 2D and 3D aim trainer built with Next.js",
  "scripts": {
    "test": "vitest run --maxWorkers=1 --pool=threads",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack && node scripts/build-offline.mjs",
    "preview": "node scripts/serve.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint src e2e",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:seo": "node scripts/check-seo.mjs",
    "format": "prettier --write src e2e scripts *.ts *.mjs *.json *.md"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "recharts": "^3.10.1",
    "three": "^0.186.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/env": "16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  }
}
